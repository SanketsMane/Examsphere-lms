# ============================================================
# ExamSphire / EXAMSPHERE LMS — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# Schema provider is MySQL (see prisma/schema.prisma)
# ============================================================

# --- Database (MySQL) ---
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/examsphere_lms"

# --- Auth (Better-Auth) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="change-me-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" to skip strict env validation in lib/env.ts (handy for local dev)
SKIP_ENV_VALIDATION="true"

# --- GitHub OAuth (optional; socialProviders is currently empty) ---
AUTH_GITHUB_CLIENT_ID=""
AUTH_GITHUB_SECRET=""

# --- Email (Nodemailer / SMTP) ---
EMAIL_SERVICE="gmail"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="EXAMSPHERE <no-reply@example.com>"

# --- Email (Resend — primary provider in lib/email.ts) ---
RESEND_API_KEY=""

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-north-1"
AWS_ENDPOINT_URL_S3="https://s3.amazonaws.com"
AWS_ENDPOINT_URL_IAM="https://iam.amazonaws.com"
NEXT_PUBLIC_AWS_REGION="eu-north-1"
NEXT_PUBLIC_S3_BUCKET_NAME_IMAGES=""

# --- Stripe (validated in lib/env.ts) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Razorpay Payment Gateway ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Tawk.to (validated in lib/env.ts) ---
TAWKTOO_API_URL="https://api.tawk.to"
TAWKTOO_API_KEY=""

# --- Twilio (phone OTP) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# --- Admin notifications ---
# Where user-submitted issue reports are emailed (app/actions/issues.ts). Unset = no admin email.
ADMIN_EMAIL=""

# --- Private storage (notes PDFs and other paid files; never the public bucket) ---
# local = files on this server's disk (set PRIVATE_STORAGE_DIR outside the app folder and back it up)
# s3    = a separate PRIVATE bucket (Cloudflare R2 / S3 / MinIO)
PRIVATE_STORAGE_DRIVER="local"
PRIVATE_STORAGE_DIR="/var/lib/examsphere/private"
# PRIVATE_S3_BUCKET=""
# PRIVATE_S3_ENDPOINT=""            # falls back to AWS_ENDPOINT_URL_S3
# PRIVATE_S3_ACCESS_KEY_ID=""       # falls back to AWS_ACCESS_KEY_ID
# PRIVATE_S3_SECRET_ACCESS_KEY=""   # falls back to AWS_SECRET_ACCESS_KEY
